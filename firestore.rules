rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Global Safety Net
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Allow the master email or any email listed in payment_settings/global adminEmails
      return isSignedIn() && (
        request.auth.token.email == 'hotelcrowncastle992@gmail.com' ||
        get(/databases/$(database)/documents/payment_settings/global).data.adminEmails.matches('.*' + request.auth.token.email + '.*')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // Entity Validations
    // -------------------------------------------------------------------------
    
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'tier']) &&
             data.uid == request.auth.uid &&
             data.tier in ['free', 'premium', 'pro', 'Nexus', 'Master Node'] &&
             (data.get('email', null) == null || data.email is string) &&
             (data.get('displayName', null) == null || data.displayName is string);
    }

    function isValidNeuralAnalysis(data) {
      return data.keys().hasAll(['userId', 'type', 'title', 'status', 'resultData', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.type in ['audit', 'blueprint', 'video', 'post', 'keyword'] &&
             data.title is string && data.title.size() <= 500 &&
             data.status is string &&
             (data.get('score', null) == null || data.score is number);
    }

    function isValidQueueItem(data) {
      return data.keys().hasAny(['userId', 'platform', 'scheduledTime']) &&
             data.userId == request.auth.uid &&
             data.platform is string;
    }

    // -------------------------------------------------------------------------
    // Collection Match Blocks
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if (isOwner(userId) && isValidUserProfile(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['tier', 'syncedNodes', 'displayName', 'updatedAt', 'youtubeToken', 'facebookToken', 'instagramToken'])) || isAdmin();
    }

    match /analysis/{analysisId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidNeuralAnalysis(incoming()) && isValidId(analysisId);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /queue/{queueId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidQueueItem(incoming()) && isValidId(queueId);
      allow update: if isSignedIn() && existing().userId == request.auth.uid &&
                    isValidQueueItem(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'scheduledTime', 'title', 'content', 'platform']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
    match /payment_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /transactions/{txId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'messages', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /system_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn(); // Allow clients to log errors
      allow update, delete: if isAdmin();
    }
  }
}
